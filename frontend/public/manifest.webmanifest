{
  "name": "Grandline — Personal Daily Tracker & Life Operating System",
  "short_name": "Grandline",
  "description": "Personal performance, habit formation, study tracking, memory preservation, and life reflection ecosystem.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "window-controls-overlay", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#f8f6f0",
  "theme_color": "#23533c",
  "lang": "en-US",
